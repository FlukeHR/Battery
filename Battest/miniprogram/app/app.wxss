page {
  --color-primary: #167c5a;
  --color-primary-dark: #0e5d43;
  --color-accent: #e99143;
  --color-ink: #15241e;
  --color-muted: #68736d;
  --color-line: #dfe6e1;
  --color-surface: #ffffff;
  --color-canvas: #f6f8f5;
  min-height: 100%;
  background: var(--color-canvas);
  color: var(--color-ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
picker {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.page-title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-subtitle {
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.65;
}

.surface-card {
  border: 1rpx solid var(--color-line);
  border-radius: 28rpx;
  background: var(--color-surface);
  box-shadow: 0 12rpx 32rpx rgba(29, 65, 51, 0.07);
}

.primary-button,
.secondary-button,
.danger-button,
.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 22rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1;
}

.primary-button {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(22, 124, 90, 0.2);
}

.primary-button[disabled] {
  background: #89ae9e;
  color: rgba(255, 255, 255, 0.85);
  box-shadow: none;
}

.secondary-button {
  border: 1rpx solid #bcd0c6;
  background: #ffffff;
  color: var(--color-primary-dark);
}

.danger-button {
  border: 1rpx solid #efc3c0;
  background: #fff8f7;
  color: #af3d37;
}

.text-button {
  min-height: 72rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 26rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.3;
}

.muted {
  color: var(--color-muted);
}

.empty-state {
  padding: 96rpx 44rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 28rpx;
  align-items: center;
  justify-content: center;
  border-radius: 56rpx;
  background: #eaf4ef;
  color: var(--color-primary);
  font-size: 46rpx;
}
